/* pages/photo-ocr/photo-ocr.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.nav-actions {
  display: flex;
  align-items: center;
}

.batch-toggle {
  font-size: 26rpx;
  color: #666;
  padding: 12rpx 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.batch-toggle.active {
  color: #1E40AF;
  border-color: #1E40AF;
  background-color: #f0f4ff;
}

/* 步骤内容 */
.step-content {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

/* 上传区域 */
.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  border: 4rpx dashed #d1d5db;
  border-radius: 16rpx;
  background-color: #f9fafb;
  margin-bottom: 30rpx;
}

.upload-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.upload-text {
  font-size: 32rpx;
  color: #333;
  text-align: center;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.upload-hint {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  line-height: 1.5;
}

/* 批量预览 */
.batch-preview {
  margin-top: 30rpx;
}

.preview-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.image-list {
  white-space: nowrap;
  height: 200rpx;
}

.image-item {
  display: inline-block;
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.image-item image {
  width: 100%;
  height: 100%;
}

/* 单张预览 */
.single-preview {
  text-align: center;
}

.preview-image {
  width: 100%;
  max-height: 500rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 结果区域 */
.result-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #e5e7eb;
}

.recognized-text {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  background-color: #f9fafb;
}

/* 题目内容 */
.question-content {
  background-color: #f8fafc;
  border-radius: 12rpx;
  padding: 30rpx;
}

.question-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 20rpx;
}

.question-type {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.options {
  margin-top: 20rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background-color: white;
  border-radius: 8rpx;
  border: 1rpx solid #e5e7eb;
}

.option-key {
  font-size: 26rpx;
  font-weight: bold;
  color: #1E40AF;
  margin-right: 12rpx;
  min-width: 40rpx;
}

.option-text {
  font-size: 26rpx;
  line-height: 1.5;
  color: #333;
  flex: 1;
}

/* 批量结果 */
.batch-results {
  margin-bottom: 30rpx;
}

.result-list {
  margin-top: 20rpx;
}

.result-item {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #e5e7eb;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.result-item.success {
  border-left-color: #10b981;
}

.result-item.error {
  border-left-color: #ef4444;
}

.result-status {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.status-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.status-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.result-preview {
  background-color: #f8fafc;
  border-radius: 8rpx;
  padding: 20rpx;
}

.preview-text {
  font-size: 26rpx;
  line-height: 1.5;
  color: #555;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.error-message {
  color: #ef4444;
  font-size: 24rpx;
}

/* AI解析区域 */
.analysis-section {
  margin-bottom: 40rpx;
}

.analysis-content {
  background-color: #f8fafc;
  border-radius: 12rpx;
  padding: 30rpx;
  border-left: 6rpx solid #1E40AF;
}

.analysis-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-line;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.btn-secondary {
  flex: 1;
  background: white;
  color: #1E40AF;
  border: 2rpx solid #1E40AF;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 30rpx;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary:active {
  background-color: #f8fafc;
}

.btn-primary[loading] {
  opacity: 0.7;
}

/* 加载遮罩 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  background: white;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 300rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e7eb;
  border-top: 4rpx solid #1E40AF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #333;
  text-align: center;
}