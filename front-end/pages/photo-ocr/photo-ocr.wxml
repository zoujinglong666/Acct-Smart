<!--pages/photo-ocr/photo-ocr.wxml-->
<view class="container">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <text class="nav-title">拍照识题</text>
    <view class="nav-actions">
      <text class="batch-toggle {{batchMode ? 'active' : ''}}" bindtap="toggleBatchMode">
        {{batchMode ? '单张模式' : '批量模式'}}
      </text>
    </view>
  </view>

  <!-- 步骤1: 拍照选择 -->
  <view class="step-content" wx:if="{{step === 1}}">
    <view class="upload-area" bindtap="chooseImage">
      <view class="upload-icon">📷</view>
      <text class="upload-text">
        {{batchMode ? '选择多张图片进行批量识别' : '拍照或选择图片识别题目'}}
      </text>
      <text class="upload-hint">
        支持JPG、PNG格式，建议图片清晰、光线充足
      </text>
    </view>

    <!-- 批量模式预览 -->
    <view class="batch-preview" wx:if="{{batchMode && batchImages.length > 0}}">
      <view class="preview-title">已选择 {{batchImages.length}} 张图片</view>
      <scroll-view class="image-list" scroll-x>
        <view class="image-item" wx:for="{{batchImages}}" wx:key="index">
          <image src="{{item}}" mode="aspectFill"></image>
        </view>
      </scroll-view>
    </view>

    <!-- 单张模式预览 -->
    <view class="single-preview" wx:if="{{!batchMode && imageUrl}}">
      <image class="preview-image" src="{{imageUrl}}" mode="aspectFit"></image>
      <button class="btn-primary" bindtap="recognizeImage" loading="{{loading}}">
        开始识别
      </button>
    </view>
  </view>

  <!-- 步骤2: 识别结果 -->
  <view class="step-content" wx:if="{{step === 2}}">
    <!-- 单张识别结果 -->
    <view wx:if="{{!batchMode}}">
      <view class="result-section">
        <view class="section-title">识别结果</view>
        <textarea 
          class="recognized-text" 
          value="{{recognizedText}}" 
          placeholder="识别的文字内容将显示在这里"
          bindinput="editRecognizedText"
        ></textarea>
      </view>

      <view class="result-section" wx:if="{{parsedQuestion}}">
        <view class="section-title">题目解析</view>
        <view class="question-content">
          <text class="question-text">{{parsedQuestion.question}}</text>
          <view class="question-type">题目类型: {{parsedQuestion.type}}</view>
          
          <view class="options" wx:if="{{parsedQuestion.options.length > 0}}">
            <view class="option-item" wx:for="{{parsedQuestion.options}}" wx:key="key">
              <text class="option-key">{{item.key}}.</text>
              <text class="option-text">{{item.text}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="action-buttons">
        <button class="btn-secondary" bindtap="retakePhoto">重新拍照</button>
        <button class="btn-primary" bindtap="generateAnalysis" loading="{{loading}}">
          生成AI解析
        </button>
      </view>
    </view>

    <!-- 批量识别结果 -->
    <view wx:if="{{batchMode}}">
      <view class="batch-results">
        <view class="section-title">批量识别结果 ({{batchResults.length}})</view>
        <view class="result-list">
          <view 
            class="result-item {{item.success ? 'success' : 'error'}}" 
            wx:for="{{batchResults}}" 
            wx:key="index"
            bindtap="viewBatchResult"
            data-index="{{index}}"
          >
            <view class="result-status">
              <text class="status-icon">{{item.success ? '✅' : '❌'}}</text>
              <text class="status-text">图片 {{index + 1}}</text>
            </view>
            <view class="result-preview" wx:if="{{item.success}}">
              <text class="preview-text">{{item.data.parsedQuestion.question}}</text>
            </view>
            <view class="error-message" wx:else>
              <text>{{item.message}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 步骤3: AI解析 -->
  <view class="step-content" wx:if="{{step === 3}}">
    <view class="analysis-section">
      <view class="section-title">AI智能解析</view>
      <view class="analysis-content">
        <text class="analysis-text">{{analysis}}</text>
      </view>
    </view>

    <view class="action-buttons">
      <button class="btn-secondary" bindtap="retakePhoto">重新识别</button>
      <button class="btn-primary" bindtap="saveQuestion">保存题目</button>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">
        {{step === 1 ? '正在识别...' : '正在生成解析...'}}
      </text>
    </view>
  </view>
</view>