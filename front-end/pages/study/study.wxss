/* pages/study/study.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

.content {
  padding-bottom: 140rpx;
}

/* 进度卡片 */
.progress-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  color: white;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-title {
  font-size: 32rpx;
  font-weight: bold;
}

.progress-percent {
  font-size: 36rpx;
  font-weight: bold;
}

.progress-bar {
  height: 8rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: white;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 章节样式 */
.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #1E40AF;
}

/* 知识点分类 */
.knowledge-categories {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.category-item {
  flex: 1;
  min-width: 200rpx;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.category-icon {
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
}

.category-icon.basic {
  background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);
}

.category-icon.asset {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
}

.category-icon.liability {
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
}

.category-icon.report {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
}

.category-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.category-count {
  font-size: 24rpx;
  color: #666;
}

/* 推荐学习列表 */
.recommended-list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.knowledge-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.knowledge-item:last-child {
  border-bottom: none;
}

.knowledge-content {
  flex: 1;
}

.knowledge-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.knowledge-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.knowledge-chapter {
  font-size: 24rpx;
  color: #666;
  margin-right: 20rpx;
}

.knowledge-difficulty {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  color: white;
}

.difficulty-easy {
  background-color: #10b981;
}

.difficulty-medium {
  background-color: #f59e0b;
}

.difficulty-hard {
  background-color: #ef4444;
}

.knowledge-progress {
  display: flex;
  align-items: center;
}

.progress-bar-small {
  width: 120rpx;
  height: 6rpx;
  background-color: #e5e7eb;
  border-radius: 3rpx;
  margin-right: 16rpx;
  overflow: hidden;
}

.progress-fill-small {
  height: 100%;
  background-color: #1E40AF;
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
}

.knowledge-action {
  margin-left: 20rpx;
}

.action-text {
  font-size: 26rpx;
  color: #1E40AF;
}

/* 学习统计网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stats-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.stats-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #1E40AF;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #666;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx;
  border-top: 1rpx solid #e5e7eb;
  display: flex;
  gap: 20rpx;
}

.btn-primary {
  flex: 2;
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-secondary {
  flex: 1;
  background: white;
  color: #1E40AF;
  border: 2rpx solid #1E40AF;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary:active {
  background-color: #f8fafc;
}