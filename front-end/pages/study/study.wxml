<!--pages/study/study.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 主要内容 -->
  <view wx:else class="content">
    <!-- 学习进度卡片 -->
    <view class="progress-card">
      <view class="progress-header">
        <text class="progress-title">今日学习进度</text>
        <text class="progress-percent">{{studyProgress}}%</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{studyProgress}}%"></view>
      </view>
      <view class="progress-stats">
        <view class="stat-item">
          <text class="stat-value">{{todayStudyTime}}</text>
          <text class="stat-label">分钟</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{completedLessons}}</text>
          <text class="stat-label">课时</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{todayQuestions}}</text>
          <text class="stat-label">题目</text>
        </view>
      </view>
    </view>

    <!-- 知识点分类 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">知识点分类</text>
        <text class="section-more" bindtap="viewAllKnowledge">查看全部</text>
      </view>
      <view class="knowledge-categories">
        <view 
          wx:for="{{knowledgeCategories}}" 
          wx:key="id"
          class="category-item"
          bindtap="selectCategory"
          data-id="{{item.id}}"
        >
          <view class="category-icon {{item.icon}}"></view>
          <text class="category-name">{{item.name}}</text>
          <text class="category-count">{{item.count}}个知识点</text>
        </view>
      </view>
    </view>

    <!-- 推荐学习 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">推荐学习</text>
      </view>
      <view class="recommended-list">
        <view 
          wx:for="{{recommendedKnowledge}}" 
          wx:key="id"
          class="knowledge-item"
          bindtap="startLearning"
          data-id="{{item.id}}"
        >
          <view class="knowledge-content">
            <view class="knowledge-title">{{item.title}}</view>
            <view class="knowledge-info">
              <text class="knowledge-chapter">{{item.chapter}}</text>
              <text class="knowledge-difficulty difficulty-{{item.difficulty}}">{{item.difficultyText}}</text>
            </view>
            <view class="knowledge-progress">
              <view class="progress-bar-small">
                <view class="progress-fill-small" style="width: {{item.progress}}%"></view>
              </view>
              <text class="progress-text">{{item.progress}}%</text>
            </view>
          </view>
          <view class="knowledge-action">
            <text class="action-text">{{item.progress > 0 ? '继续学习' : '开始学习'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 学习统计 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">学习统计</text>
      </view>
      <view class="stats-grid">
        <view class="stats-item">
          <text class="stats-value">{{totalStudyTime}}</text>
          <text class="stats-label">总学习时长(分钟)</text>
        </view>
        <view class="stats-item">
          <text class="stats-value">{{completedKnowledge}}</text>
          <text class="stats-label">已完成知识点</text>
        </view>
        <view class="stats-item">
          <text class="stats-value">{{averageScore}}</text>
          <text class="stats-label">平均分数</text>
        </view>
        <view class="stats-item">
          <text class="stats-value">{{studyDays}}</text>
          <text class="stats-label">学习天数</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="bottom-actions">
    <button class="btn-primary" bindtap="startDailyStudy">开始今日学习</button>
    <button class="btn-secondary" bindtap="viewStudyPlan">查看学习计划</button>
  </view>
</view>