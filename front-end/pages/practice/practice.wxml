<!--pages/practice/practice.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 章节练习：选择知识点 -->
  <view wx:elif="{{mode === 'chapter' && !questions.length && !finished}}" class="chapter-select">
    <view class="title">选择知识点</view>
    <view class="knowledge-list">
      <view class="knowledge-item {{selectedKnowledgeId === item.id ? 'selected' : ''}}"
            wx:for="{{knowledgePoints}}" wx:key="id"
            bindtap="selectKnowledge" data-id="{{item.id}}">
        <view class="knowledge-info">
          <text class="knowledge-title">{{item.title}}</text>
          <text class="knowledge-chapter">{{item.chapterNumber || '未分类'}}</text>
        </view>
        <view class="knowledge-arrow">{{selectedKnowledgeId === item.id ? '✓' : '>'}}</view>
      </view>
    </view>
  </view>

  <!-- 错题重练：无错题时提示 -->
  <view wx:elif="{{mode === 'wrong' && !questions.length && !finished}}" class="empty">
    <view class="empty-icon">📝</view>
    <text class="empty-title">暂无错题</text>
    <text class="empty-desc">先去练习，答错的题会自动进入错题本</text>
    <button class="btn-primary" bindtap="goWrongBook">去错题本看看</button>
  </view>

  <!-- 答题中 -->
  <view wx:elif="{{questions.length && !finished}}" class="session">
    <view class="session-header">
      <view class="mode-label">{{getTypeName(currentQuestion.type)}}</view>
      <view class="progress-text">{{currentIndex + 1}} / {{questions.length}}</view>
      <view class="difficulty-tag difficulty-{{currentQuestion.difficulty}}">
        {{getDifficultyText(currentQuestion.difficulty)}}
      </view>
    </view>

    <view class="question-content">
      <view class="question-text">{{currentQuestion.content}}</view>
    </view>

    <!-- 选项 -->
    <view class="options">
      <view class="option {{selectedAnswer === item.key ? 'selected' : ''}} {{result ? (item.key === result.correctAnswer ? 'correct' : (selectedAnswer === item.key ? 'wrong' : '')) : ''}}"
            wx:for="{{currentQuestion.options}}" wx:key="key"
            bindtap="selectAnswer" data-key="{{item.key}}">
        <view class="option-key">{{item.key}}</view>
        <view class="option-text">{{item.text}}</view>
        <view class="option-check" wx:if="{{selectedAnswer === item.key}}">✓</view>
      </view>
    </view>

    <!-- 答题结果 -->
    <view class="result-panel {{result ? (result.isCorrect ? 'correct' : 'wrong') : ''}}" wx:if="{{result}}">
      <view class="result-title">{{result.isCorrect ? '回答正确！' : '回答错误'}}</view>
      <view class="result-answer" wx:if="{{!result.isCorrect}}">
        正确答案：{{result.correctAnswer}}
      </view>
      <view class="result-explanation">{{result.explanation}}</view>
    </view>

    <!-- 操作栏 -->
    <view class="action-bar">
      <button wx:if="{{!result}}" class="btn-primary submit-btn" bindtap="submitAnswer">提交本题</button>
      <button wx:else class="btn-primary submit-btn" bindtap="nextQuestion">
        {{currentIndex === questions.length - 1 ? '查看结果' : '下一题'}}
      </button>
      <button wx:if="{{mode === 'chapter'}}" class="btn-secondary submit-btn" bindtap="backToChapter">换章节</button>
    </view>

    <view class="timer">已用时 {{formatTime(timeUsed)}}</view>
  </view>

  <!-- 练习完成 -->
  <view wx:elif="{{finished}}" class="result">
    <view class="result-icon">🎉</view>
    <view class="result-title">练习完成</view>
    <view class="result-score">{{correctCount}} / {{questions.length}}</view>
    <view class="result-rate">正确率 {{questions.length ? Math.round(correctCount / questions.length * 100) : 0}}%</view>
    <view class="result-time">用时 {{formatTime(timeUsed)}}</view>

    <view class="result-actions">
      <button class="btn-primary" bindtap="restart">再练一次</button>
      <button class="btn-secondary" bindtap="goWrongBook">去错题本</button>
      <button class="btn-secondary" bindtap="goHome">返回首页</button>
    </view>
  </view>
</view>
