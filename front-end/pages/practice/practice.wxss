/* pages/practice/practice.wxss */
.container {
  padding: 24rpx;
  background: #F3F4F6;
  min-height: 100vh;
  box-sizing: border-box;
}

.loading, .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 34rpx; color: #374151; font-weight: 600; margin-bottom: 12rpx; }
.empty-desc { margin-bottom: 40rpx; text-align: center; }

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 24rpx;
}

/* 章节选择 */
.chapter-select {
  padding: 24rpx 0;
}

.knowledge-list {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.knowledge-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.knowledge-item:last-child { border-bottom: none; }
.knowledge-item.selected { background: #EFF6FF; }

.knowledge-title { font-size: 30rpx; color: #1F2937; display: block; }
.knowledge-chapter { font-size: 24rpx; color: #9CA3AF; margin-top: 6rpx; display: block; }
.knowledge-arrow { color: #9CA3AF; font-size: 28rpx; }
.knowledge-item.selected .knowledge-arrow { color: #1E40AF; font-weight: 600; }

/* 答题中 */
.session {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
}

.session-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.mode-label {
  background: #1E40AF;
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.progress-text { font-size: 28rpx; color: #6B7280; }

.difficulty-tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.difficulty-easy { background: #D1FAE5; color: #059669; }
.difficulty-medium { background: #FEF3C7; color: #D97706; }
.difficulty-hard { background: #FEE2E2; color: #DC2626; }

.question-text {
  font-size: 32rpx;
  color: #111827;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.options { margin-bottom: 32rpx; }

.option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s;
}

.option.selected { border-color: #1E40AF; background: #EFF6FF; }
.option.correct { border-color: #059669; background: #ECFDF5; }
.option.wrong { border-color: #DC2626; background: #FEF2F2; }

.option-key {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #F3F4F6;
  color: #374151;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option.selected .option-key { background: #1E40AF; color: #FFFFFF; }
.option.correct .option-key { background: #059669; color: #FFFFFF; }
.option.wrong .option-key { background: #DC2626; color: #FFFFFF; }

.option-text { font-size: 30rpx; color: #1F2937; flex: 1; }
.option-check { color: #1E40AF; font-weight: 600; }

/* 结果面板 */
.result-panel {
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.result-panel.correct { background: #ECFDF5; }
.result-panel.wrong { background: #FEF2F2; }

.result-title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.result-panel.correct .result-title { color: #059669; }
.result-panel.wrong .result-title { color: #DC2626; }

.result-answer { font-size: 28rpx; color: #DC2626; margin-bottom: 8rpx; }
.result-explanation { font-size: 26rpx; color: #4B5563; line-height: 1.6; }

/* 操作栏 */
.action-bar { margin-top: 8rpx; }

.btn-primary {
  width: 100%;
  background: #1E40AF;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  margin-bottom: 16rpx;
}

.btn-primary::after { border: none; }

.timer {
  text-align: center;
  color: #9CA3AF;
  font-size: 24rpx;
  margin-top: 16rpx;
}

/* 练习完成 */
.result {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 60rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.result-title { font-size: 36rpx; font-weight: 600; color: #111827; margin-bottom: 16rpx; }
.result-score { font-size: 64rpx; font-weight: 700; color: #1E40AF; margin-bottom: 8rpx; }
.result-rate { font-size: 28rpx; color: #4B5563; margin-bottom: 8rpx; }
.result-time { font-size: 26rpx; color: #9CA3AF; margin-bottom: 48rpx; }

.result-actions { width: 100%; }

.btn-secondary {
  width: 100%;
  background: #F3F4F6;
  color: #374151;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  margin-bottom: 16rpx;
}

.btn-secondary::after { border: none; }
