<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:else>
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <view class="user-header" bindtap="handleAvatarTap">
        <image class="user-avatar"
               src="{{userInfo ? userInfo.avatar : 'data:image/svg+xml;base64,'}}"
               mode="aspectFill" />
        <view class="user-info">
          <text class="user-name">{{userInfo ? userInfo.nickname : '点击登录'}}</text>
          <text wx:if="{{userInfo}}" class="user-desc">继续加油，坚持就是胜利</text>
          <text wx:else class="login-tip">登录后查看学习数据</text>
        </view>
        <view class="arrow">></view>
      </view>

      <!-- 学习统计 -->
      <view wx:if="{{userInfo}}" class="stats-grid">
        <view class="stat-item">
          <text class="stat-number">{{formatStudyTime(studyStats.totalStudyTime)}}</text>
          <text class="stat-label">学习时长</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">{{studyStats.continuousStudyDays}}</text>
          <text class="stat-label">连续天数</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">{{studyStats.totalQuestions}}</text>
          <text class="stat-label">答题总数</text>
        </view>
        <view class="stat-item">
          <text class="stat-number">{{studyStats.correctRate}}%</text>
          <text class="stat-label">正确率</text>
        </view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-section">
      <view class="menu-item" bindtap="goWrongBook">
        <view class="menu-icon">❌</view>
        <view class="menu-content">
          <text class="menu-name">错题本</text>
          <text class="menu-desc">复习错题，巩固知识</text>
        </view>
        <view class="menu-arrow">></view>
      </view>
      <view class="menu-item" bindtap="contactService">
        <view class="menu-icon">💬</view>
        <view class="menu-content">
          <text class="menu-name">联系客服</text>
          <text class="menu-desc">如有问题，欢迎反馈</text>
        </view>
        <view class="menu-arrow">></view>
      </view>
    </view>

    <!-- 退出登录 -->
    <view wx:if="{{userInfo}}" class="logout-section">
      <button class="logout-btn" bindtap="logout">退出登录</button>
    </view>

    <!-- 版本信息 -->
    <view class="version-info">
      <text class="version-text">AI中级会计助手 v1.0.0</text>
    </view>
  </view>
</view>
