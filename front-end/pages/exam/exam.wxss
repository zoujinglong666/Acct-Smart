/* pages/exam/exam.wxss */

/* 考试统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(30, 64, 175, 0.3);
}

.stats-header {
  margin-bottom: 32rpx;
}

.stats-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 标签页 */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #6B7280;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #1E40AF;
  color: #FFFFFF;
}

/* 搜索和筛选 */
.search-section {
  margin-bottom: 24rpx;
}

.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.filter-buttons {
  display: flex;
  gap: 16rpx;
}

.filter-btn {
  background: #F3F4F6;
  color: #6B7280;
  border: none;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.filter-btn.active {
  background: #1E40AF;
  color: #FFFFFF;
}

/* 考试列表 */
.exam-list {
  margin-top: 24rpx;
}

.exam-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
  border: 2rpx solid rgba(30, 64, 175, 0.05);
}

.exam-header {
  margin-bottom: 20rpx;
}

.exam-title-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.exam-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  flex: 1;
  margin-right: 20rpx;
}

.exam-tags {
  display: flex;
  gap: 12rpx;
}

.exam-type-tag {
  background: #DBEAFE;
  color: #1E40AF;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.difficulty-tag {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.difficulty-easy {
  background: #D1FAE5;
  color: #10B981;
}

.difficulty-medium {
  background: #FEF3C7;
  color: #F59E0B;
}

.difficulty-hard {
  background: #FEE2E2;
  color: #EF4444;
}

.exam-description {
  margin-bottom: 24rpx;
}

.exam-description text {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.6;
}

.exam-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  align-items: center;
  flex: 1;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.info-text {
  font-size: 24rpx;
  color: #6B7280;
}

.exam-tags-list {
  margin-bottom: 24rpx;
}

.tag {
  display: inline-block;
  background: #F3F4F6;
  color: #6B7280;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.exam-actions {
  display: flex;
  gap: 20rpx;
}

.exam-actions .btn-primary,
.exam-actions .btn-secondary {
  flex: 1;
  margin: 0;
}

/* 考试记录 */
.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
}

.btn-export {
  background: #10B981;
  color: #FFFFFF;
  border: none;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.history-list {
  margin-top: 24rpx;
}

.history-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
}

.history-header-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  flex: 1;
}

.history-date {
  font-size: 24rpx;
  color: #6B7280;
}

.history-score-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.score-display {
  display: flex;
  align-items: baseline;
}

.score-number {
  font-size: 48rpx;
  font-weight: 700;
  margin-right: 8rpx;
}

.score-number.passed {
  color: #10B981;
}

.score-number.failed {
  color: #EF4444;
}

.score-total {
  font-size: 28rpx;
  color: #6B7280;
}

.score-status {
  text-align: right;
}

.status-text {
  font-size: 28rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.status-text.passed {
  background: #D1FAE5;
  color: #10B981;
}

.status-text.failed {
  background: #FEE2E2;
  color: #EF4444;
}

.history-details {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.detail-label {
  font-size: 22rpx;
  color: #6B7280;
  margin-bottom: 8rpx;
}

.detail-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2937;
}

.history-actions {
  display: flex;
  gap: 16rpx;
}

.history-actions .btn-secondary,
.history-actions .btn-primary {
  flex: 1;
  margin: 0;
}

.btn-share {
  background: #F59E0B;
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  flex: 1;
}

/* 模拟考试 */
.mock-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.btn-create {
  background: #10B981;
  color: #FFFFFF;
  border: none;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.mock-intro {
  margin-bottom: 32rpx;
}

.intro-card {
  background: linear-gradient(135deg, #10B981 0%, #34D399 100%);
  color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
}

.intro-icon {
  font-size: 80rpx;
  margin-right: 32rpx;
}

.intro-content {
  flex: 1;
}

.intro-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.intro-desc {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.5;
}

.mock-features {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
}

.feature-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.feature-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #6B7280;
  text-align: center;
  line-height: 1.4;
}

.mock-exams {
  margin-top: 32rpx;
}

.mock-exam-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
}

.mock-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 12rpx;
}

.mock-desc {
  display: block;
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.mock-info {
  margin-bottom: 24rpx;
}

.mock-info text {
  font-size: 24rpx;
  color: #6B7280;
  background: #F3F4F6;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.full-width {
  width: 100%;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.5;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 60rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}