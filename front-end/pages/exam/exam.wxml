<!--pages/exam/exam.wxml-->
<view class="container">
  <!-- 考试统计卡片 -->
  <view class="stats-card">
    <view class="stats-header">
      <text class="stats-title">考试统计</text>
    </view>
    <view class="stats-grid">
      <view class="stats-item">
        <text class="stats-number">{{examStats.totalExams}}</text>
        <text class="stats-label">总考试</text>
      </view>
      <view class="stats-item">
        <text class="stats-number">{{examStats.passedExams}}</text>
        <text class="stats-label">已通过</text>
      </view>
      <view class="stats-item">
        <text class="stats-number">{{examStats.averageScore}}</text>
        <text class="stats-label">平均分</text>
      </view>
      <view class="stats-item">
        <text class="stats-number">{{getPassRate()}}%</text>
        <text class="stats-label">通过率</text>
      </view>
    </view>
  </view>

  <!-- 标签页切换 -->
  <view class="tab-bar">
    <view class="tab-item {{selectedTab === 'available' ? 'active' : ''}}" 
          bindtap="switchTab" data-tab="available">
      <text>可用考试</text>
    </view>
    <view class="tab-item {{selectedTab === 'history' ? 'active' : ''}}" 
          bindtap="switchTab" data-tab="history">
      <text>考试记录</text>
    </view>
    <view class="tab-item {{selectedTab === 'mock' ? 'active' : ''}}" 
          bindtap="switchTab" data-tab="mock">
      <text>模拟考试</text>
    </view>
  </view>

  <!-- 可用考试列表 -->
  <view wx:if="{{selectedTab === 'available'}}">
    <!-- 搜索和筛选 -->
    <view class="search-section">
      <view class="search-bar">
        <input class="search-input" placeholder="搜索考试..." bindinput="searchExams" />
      </view>
      <view class="filter-buttons">
        <button class="filter-btn" bindtap="filterExams" data-filter="all">全部</button>
        <button class="filter-btn" bindtap="filterExams" data-filter="chapter">章节</button>
        <button class="filter-btn" bindtap="filterExams" data-filter="comprehensive">综合</button>
        <button class="filter-btn" bindtap="filterExams" data-filter="mock">模拟</button>
      </view>
    </view>

    <!-- 考试列表 -->
    <view class="exam-list">
      <view class="exam-item" wx:for="{{examList}}" wx:key="id">
        <view class="exam-header">
          <view class="exam-title-section">
            <text class="exam-title">{{item.title}}</text>
            <view class="exam-tags">
              <text class="exam-type-tag">{{getExamTypeText(item.type)}}</text>
              <text class="difficulty-tag {{getDifficultyClass(item.difficulty)}}">
                {{getDifficultyText(item.difficulty)}}
              </text>
            </view>
          </view>
        </view>
        
        <view class="exam-description">
          <text>{{item.description}}</text>
        </view>
        
        <view class="exam-info">
          <view class="info-item">
            <text class="info-icon">📝</text>
            <text class="info-text">{{item.questionCount}}题</text>
          </view>
          <view class="info-item">
            <text class="info-icon">⏰</text>
            <text class="info-text">{{formatTime(item.timeLimit)}}</text>
          </view>
          <view class="info-item">
            <text class="info-icon">🎯</text>
            <text class="info-text">及格{{item.passScore}}分</text>
          </view>
        </view>
        
        <view class="exam-tags-list" wx:if="{{item.tags && item.tags.length > 0}}">
          <text class="tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
        </view>
        
        <view class="exam-actions">
          <button class="btn-secondary" bindtap="viewExamDetail" data-id="{{item.id}}">查看详情</button>
          <button class="btn-primary" bindtap="startExam" data-id="{{item.id}}">开始考试</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 考试记录 -->
  <view wx:if="{{selectedTab === 'history'}}">
    <view class="history-header">
      <text class="section-title">考试记录</text>
      <button class="btn-export" bindtap="exportExamHistory">导出记录</button>
    </view>
    
    <view class="history-list" wx:if="{{examHistory.length > 0}}">
      <view class="history-item" wx:for="{{examHistory}}" wx:key="id">
        <view class="history-header-info">
          <text class="history-title">{{item.examTitle}}</text>
          <text class="history-date">{{formatDate(item.completedAt)}}</text>
        </view>
        
        <view class="history-score-section">
          <view class="score-display">
            <text class="score-number {{item.passed ? 'passed' : 'failed'}}">{{item.score}}</text>
            <text class="score-total">/{{item.totalScore}}</text>
          </view>
          <view class="score-status">
            <text class="status-text {{item.passed ? 'passed' : 'failed'}}">
              {{item.passed ? '通过' : '未通过'}}
            </text>
          </view>
        </view>
        
        <view class="history-details">
          <view class="detail-item">
            <text class="detail-label">正确率:</text>
            <text class="detail-value">{{item.accuracy}}%</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">用时:</text>
            <text class="detail-value">{{item.timeUsed}}/{{item.timeLimit}}分钟</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">答对:</text>
            <text class="detail-value">{{item.correctCount}}/{{item.totalCount}}题</text>
          </view>
        </view>
        
        <view class="history-actions">
          <button class="btn-secondary" bindtap="viewExamResult" data-id="{{item.id}}">查看详情</button>
          <button class="btn-primary" bindtap="retakeExam" data-exam-id="{{item.examId}}">重新考试</button>
          <button class="btn-share" bindtap="shareExamResult" data-score="{{item.score}}">分享</button>
        </view>
      </view>
    </view>
    
    <view class="empty-state" wx:if="{{examHistory.length === 0}}">
      <view class="empty-icon">📋</view>
      <text class="empty-title">暂无考试记录</text>
      <text class="empty-desc">完成考试后，记录会显示在这里</text>
    </view>
  </view>

  <!-- 模拟考试 -->
  <view wx:if="{{selectedTab === 'mock'}}">
    <view class="mock-header">
      <text class="section-title">模拟考试</text>
      <button class="btn-create" bindtap="createMockExam">创建模拟考试</button>
    </view>
    
    <view class="mock-intro">
      <view class="intro-card">
        <view class="intro-icon">🎯</view>
        <view class="intro-content">
          <text class="intro-title">全真模拟考试</text>
          <text class="intro-desc">按照真实考试标准，全面检验学习成果</text>
        </view>
      </view>
    </view>
    
    <view class="mock-features">
      <view class="feature-item">
        <view class="feature-icon">⏱️</view>
        <text class="feature-title">严格计时</text>
        <text class="feature-desc">按照真实考试时间限制</text>
      </view>
      <view class="feature-item">
        <view class="feature-icon">📊</view>
        <text class="feature-title">详细分析</text>
        <text class="feature-desc">提供全面的成绩分析报告</text>
      </view>
      <view class="feature-item">
        <view class="feature-icon">🏆</view>
        <text class="feature-title">排名对比</text>
        <text class="feature-desc">与其他考生成绩对比</text>
      </view>
    </view>
    
    <view class="mock-exams">
      <view class="mock-exam-item">
        <text class="mock-title">中级会计实务 - 全真模拟</text>
        <text class="mock-desc">包含所有章节内容，难度与真实考试相当</text>
        <view class="mock-info">
          <text>120分钟 | 60题 | 综合难度</text>
        </view>
        <button class="btn-primary full-width" bindtap="startExam" data-id="mock_1">开始模拟考试</button>
      </view>
      
      <view class="mock-exam-item">
        <text class="mock-title">财务管理 - 全真模拟</text>
        <text class="mock-desc">涵盖财务管理核心知识点</text>
        <view class="mock-info">
          <text>120分钟 | 55题 | 综合难度</text>
        </view>
        <button class="btn-primary full-width" bindtap="startExam" data-id="mock_2">开始模拟考试</button>
      </view>
      
      <view class="mock-exam-item">
        <text class="mock-title">经济法 - 全真模拟</text>
        <text class="mock-desc">经济法重点法条和案例分析</text>
        <view class="mock-info">
          <text>120分钟 | 50题 | 综合难度</text>
        </view>
        <button class="btn-primary full-width" bindtap="startExam" data-id="mock_3">开始模拟考试</button>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>