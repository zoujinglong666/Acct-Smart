/* pages/ai-chat/ai-chat.wxss */

.container {
  display: flex;
  height: 100vh;
  background: #F3F4F6;
}

/* 聊天历史侧边栏 */
.chat-history {
  width: 300rpx;
  background: #FFFFFF;
  border-right: 2rpx solid #E5E7EB;
  display: flex;
  flex-direction: column;
}

.history-header {
  padding: 32rpx 24rpx;
  border-bottom: 2rpx solid #E5E7EB;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.new-chat-btn {
  font-size: 24rpx;
  color: #1E40AF;
  padding: 8rpx 16rpx;
  border: 2rpx solid #1E40AF;
  border-radius: 8rpx;
}

.history-list {
  flex: 1;
  padding: 16rpx 0;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
  transition: background 0.2s ease;
}

.history-item:active {
  background: #F9FAFB;
}

.history-content {
  flex: 1;
  min-width: 0;
}

.history-item-title {
  display: block;
  font-size: 26rpx;
  color: #1F2937;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-time {
  font-size: 22rpx;
  color: #9CA3AF;
}

.history-delete {
  color: #EF4444;
  font-size: 32rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.history-delete:active {
  background: #FEE2E2;
}

/* 主聊天区域 */
.chat-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

/* 聊天头部 */
.chat-header {
  background: #FFFFFF;
  padding: 32rpx 40rpx;
  border-bottom: 2rpx solid #E5E7EB;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-info {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.header-status {
  font-size: 24rpx;
  color: #10B981;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #6B7280;
  padding: 12rpx 20rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 8rpx;
  background: #FFFFFF;
}

.action-btn:active {
  background: #F9FAFB;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

/* 快捷问题 */
.quick-questions {
  margin-bottom: 40rpx;
  text-align: center;
}

.quick-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 32rpx;
}

.question-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.question-item {
  background: #FFFFFF;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  font-size: 26rpx;
  color: #374151;
  text-align: center;
  line-height: 1.4;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.question-item:active {
  background: #F0F9FF;
  border-color: #1E40AF;
  color: #1E40AF;
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 16rpx rgba(30, 64, 175, 0.1);
}

/* 消息项 */
.message-item {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}

.message-item.user {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #E5E7EB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin: 0 16rpx;
  flex-shrink: 0;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-item.user .message-content {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.message-bubble {
  max-width: 80%;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  position: relative;
  word-wrap: break-word;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.message-bubble.ai {
  background: #FFFFFF;
  border: 2rpx solid #E5E7EB;
  border-bottom-left-radius: 8rpx;
}

.message-bubble.user {
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  color: #FFFFFF;
  border-bottom-right-radius: 8rpx;
}

.message-bubble.error {
  background: #FEF2F2;
  border-color: #FECACA;
  color: #DC2626;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.message-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.action-copy {
  font-size: 24rpx;
  color: #6B7280;
  padding: 8rpx 16rpx;
  border: 1rpx solid #E5E7EB;
  border-radius: 8rpx;
  background: #F9FAFB;
}

.action-copy:active {
  background: #E5E7EB;
}

.message-time {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
  display: block;
}

.message-item.user .message-time {
  text-align: right;
}

/* 输入中状态 */
.typing-indicator {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.typing-bubble {
  background: #FFFFFF;
  border: 2rpx solid #E5E7EB;
  border-radius: 24rpx;
  border-bottom-left-radius: 8rpx;
  padding: 24rpx 32rpx;
  margin-left: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.typing-dots {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #9CA3AF;
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes typing {
  0%, 80%, 100% {
    transform: scale(0.8);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 输入区域 */
.input-area {
  background: #FFFFFF;
  border-top: 2rpx solid #E5E7EB;
  padding: 24rpx;
}

.input-container {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
}

.message-input {
  flex: 1;
  min-height: 80rpx;
  max-height: 200rpx;
  font-size: 28rpx;
  color: #1F2937;
  background: transparent;
  border: none;
  outline: none;
  resize: none;
  line-height: 1.5;
}

.send-btn {
  width: 120rpx;
  height: 64rpx;
  background: #E5E7EB;
  color: #9CA3AF;
  border: none;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.send-btn.active {
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(30, 64, 175, 0.3);
}

.send-btn:active.active {
  transform: translateY(1rpx);
  box-shadow: 0 2rpx 8rpx rgba(30, 64, 175, 0.4);
}

.input-tips {
  margin-top: 16rpx;
  text-align: center;
}

.tip-text {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 移动端适配 */
@media (max-width: 750rpx) {
  .chat-history {
    display: none;
  }
  
  .container {
    flex-direction: column;
  }
  
  .chat-main {
    height: 100vh;
  }
  
  .question-grid {
    grid-template-columns: 1fr;
  }
  
  .message-bubble {
    max-width: 90%;
  }
  
  .input-container {
    padding: 12rpx 20rpx;
  }
  
  .message-input {
    min-height: 60rpx;
  }
  
  .send-btn {
    width: 100rpx;
    height: 56rpx;
    font-size: 24rpx;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .container {
    background: #111827;
  }
  
  .chat-history,
  .chat-header,
  .input-area {
    background: #1F2937;
    border-color: #374151;
  }
  
  .history-title,
  .header-title {
    color: #F9FAFB;
  }
  
  .history-item-title {
    color: #E5E7EB;
  }
  
  .message-bubble.ai {
    background: #374151;
    border-color: #4B5563;
    color: #F9FAFB;
  }
  
  .message-text {
    color: inherit;
  }
  
  .question-item {
    background: #374151;
    border-color: #4B5563;
    color: #E5E7EB;
  }
  
  .question-item:active {
    background: #1E3A8A;
    border-color: #3B82F6;
    color: #BFDBFE;
  }
  
  .input-container {
    background: #374151;
    border-color: #4B5563;
  }
  
  .message-input {
    color: #F9FAFB;
  }
}

/* 滚动条样式 */
::-webkit-scrollbar {
  width: 8rpx;
}

::-webkit-scrollbar-track {
  background: #F3F4F6;
  border-radius: 4rpx;
}

::-webkit-scrollbar-thumb {
  background: #D1D5DB;
  border-radius: 4rpx;
}

::-webkit-scrollbar-thumb:hover {
  background: #9CA3AF;
}

/* 动画效果 */
.message-item {
  animation: fadeInUp 0.3s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.question-item {
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}