<!--pages/wrong/wrong.wxml-->
<view class="container">
  <!-- 统计卡片 -->
  <view class="stats-section">
    <view class="stats-card">
      <view class="stats-item">
        <text class="stats-number">{{statistics.total}}</text>
        <text class="stats-label">总错题</text>
      </view>
      <view class="stats-item">
        <text class="stats-number">{{statistics.solved}}</text>
        <text class="stats-label">已掌握</text>
      </view>
      <view class="stats-item">
        <text class="stats-number">{{statistics.unsolved}}</text>
        <text class="stats-label">未掌握</text>
      </view>
      <view class="stats-item">
        <text class="stats-number">{{statistics.recentWeek}}</text>
        <text class="stats-label">本周新增</text>
      </view>
    </view>
  </view>

  <!-- 搜索和筛选 -->
  <view class="search-section">
    <view class="search-bar">
      <input class="search-input" placeholder="搜索错题..." bindinput="onSearch" />
    </view>

    <view class="filter-tabs">
      <view class="filter-tab {{currentFilter === 'all' ? 'active' : ''}}"
            bindtap="switchFilter" data-filter="all">
        <text>全部</text>
      </view>
      <view class="filter-tab {{currentFilter === 'recent' ? 'active' : ''}}"
            bindtap="switchFilter" data-filter="recent">
        <text>最近</text>
      </view>
      <view class="filter-tab {{currentFilter === 'frequent' ? 'active' : ''}}"
            bindtap="switchFilter" data-filter="frequent">
        <text>常错</text>
      </view>
      <view class="filter-tab {{currentFilter === 'unsolved' ? 'active' : ''}}"
            bindtap="switchFilter" data-filter="unsolved">
        <text>未掌握</text>
      </view>
    </view>
  </view>

  <!-- 错题列表 -->
  <view class="question-list">
    <view class="question-item" wx:for="{{filteredQuestions}}" wx:key="id">
      <view class="question-header">
        <text class="question-title">{{item.question ? item.question.content : '题目已删除'}}</text>
      </view>

      <view class="question-tags">
        <text class="wrong-count-tag">错{{item.wrongCount}}次</text>
        <text class="status-text {{item.isSolved ? 'solved' : 'unsolved'}}">
          {{item.isSolved ? '已掌握' : '未掌握'}}
        </text>
        <text class="question-date">{{formatDate(item.createdAt)}}</text>
      </view>

      <view class="answers" wx:if="{{item.userAnswer || item.correctAnswer}}">
        <view class="answer-line">
          <text class="answer-label">你的答案：</text>
          <text class="answer-value error">{{item.userAnswer || '未作答'}}</text>
        </view>
        <view class="answer-line">
          <text class="answer-label">正确答案：</text>
          <text class="answer-value correct">{{item.correctAnswer || '-'}}</text>
        </view>
        <view class="answer-line" wx:if="{{item.explanation}}">
          <text class="answer-label">解析：</text>
          <text class="answer-value">{{item.explanation}}</text>
        </view>
      </view>

      <view class="item-actions">
        <button class="item-btn primary" wx:if="{{!item.isSolved}}"
                bindtap="markMastered" data-id="{{item.id}}">标记已掌握</button>
        <button class="item-btn danger" bindtap="deleteWrong" data-id="{{item.id}}">删除</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{filteredQuestions.length === 0 && !loading}}">
    <view class="empty-icon">📝</view>
    <text class="empty-title">暂无错题</text>
    <text class="empty-desc">完成练习后，答错的题会自动收集到这里</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
