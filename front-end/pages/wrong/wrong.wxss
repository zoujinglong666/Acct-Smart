/* pages/wrong/wrong.wxss */

/* 统计卡片 */
.stats-section {
  margin-bottom: 24rpx;
}

.stats-card {
  background: linear-gradient(135deg, #EF4444 0%, #F87171 100%);
  color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 8rpx 32rpx rgba(239, 68, 68, 0.3);
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 搜索和筛选 */
.search-section {
  margin-bottom: 24rpx;
}

.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.filter-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
}

.filter-tabs {
  display: flex;
  margin-bottom: 20rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #6B7280;
  margin-right: 12rpx;
  transition: all 0.3s ease;
}

.filter-tab:last-child {
  margin-right: 0;
}

.filter-tab.active {
  background: #EF4444;
  color: #FFFFFF;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
}

.filter-btn,
.sort-btn {
  background: #F3F4F6;
  color: #6B7280;
  border: none;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.filter-btn.active,
.sort-btn.active {
  background: #EF4444;
  color: #FFFFFF;
}

/* 操作按钮 */
.action-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action-section .btn-primary,
.action-section .btn-secondary {
  flex: 1;
  margin: 0;
}

/* 批量操作栏 */
.batch-actions {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
}

.batch-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.batch-info text {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
}

.select-all-btn {
  background: #1E40AF;
  color: #FFFFFF;
  border: none;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.batch-buttons {
  display: flex;
  gap: 16rpx;
}

.batch-btn {
  flex: 1;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.batch-btn.delete {
  background: #FEE2E2;
  color: #EF4444;
}

.batch-btn.solved {
  background: #D1FAE5;
  color: #10B981;
}

/* 错题列表 */
.question-list {
  margin-bottom: 24rpx;
}

.question-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
  display: flex;
  align-items: flex-start;
  overflow: hidden;
}

.question-checkbox {
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  border: 3rpx solid #E5E7EB;
  color: #9CA3AF;
}

.checkbox.checked {
  background: #EF4444;
  border-color: #EF4444;
  color: #FFFFFF;
}

.question-content {
  flex: 1;
  padding: 24rpx;
  padding-left: 0;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.question-title {
  font-size: 30rpx;
  color: #1F2937;
  line-height: 1.5;
  flex: 1;
  margin-right: 20rpx;
}

.question-tags {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.difficulty-tag {
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  text-align: center;
}

.difficulty-easy {
  background: #D1FAE5;
  color: #10B981;
}

.difficulty-medium {
  background: #FEF3C7;
  color: #F59E0B;
}

.difficulty-hard {
  background: #FEE2E2;
  color: #EF4444;
}

.wrong-count-tag {
  background: #FEE2E2;
  color: #EF4444;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  text-align: center;
}

.question-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.question-chapter {
  font-size: 24rpx;
  color: #6B7280;
}

.question-date {
  font-size: 22rpx;
  color: #9CA3AF;
}

.question-status {
  text-align: right;
}

.status-text {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-text.solved {
  background: #D1FAE5;
  color: #10B981;
}

.status-text.unsolved {
  background: #FEE2E2;
  color: #EF4444;
}

/* 筛选面板 */
.filter-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.panel-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.panel-content {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 70%;
  background: #FFFFFF;
  box-shadow: -4rpx 0 20rpx rgba(0, 0, 0, 0.1);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #F3F4F6;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.panel-close {
  background: none;
  border: none;
  font-size: 48rpx;
  color: #9CA3AF;
  padding: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel-body {
  padding: 32rpx;
}

.filter-group {
  margin-bottom: 32rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 20rpx;
  display: block;
}

.category-list {
  margin-top: 16rpx;
}

.category-item {
  padding: 20rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  cursor: pointer;
}

.category-item.active {
  border-color: #EF4444;
  background: #FEF2F2;
}

.category-item text {
  font-size: 26rpx;
  color: #1F2937;
}

/* 底部操作栏 */
.bottom-actions {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  background: #F3F4F6;
  color: #6B7280;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.action-btn:first-child {
  background: #DBEAFE;
  color: #1E40AF;
}

.action-btn:nth-child(2) {
  background: #D1FAE5;
  color: #10B981;
}

.action-btn:last-child {
  background: #FEF3C7;
  color: #F59E0B;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.5;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 60rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}