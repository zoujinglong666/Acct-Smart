/* pages/wrong/wrong.wxss */
.container {
  padding: 24rpx;
  background: #F3F4F6;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 统计卡片 */
.stats-section { margin-bottom: 24rpx; }

.stats-card {
  background: #1E40AF;
  border-radius: 16rpx;
  padding: 32rpx 16rpx;
  display: flex;
  justify-content: space-between;
}

.stats-item { text-align: center; flex: 1; }
.stats-number { display: block; font-size: 44rpx; font-weight: 700; color: #FFFFFF; }
.stats-label { display: block; font-size: 24rpx; color: rgba(255, 255, 255, 0.8); margin-top: 8rpx; }

/* 搜索和筛选 */
.search-section { margin-bottom: 24rpx; }

.search-bar {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.search-input { font-size: 28rpx; color: #1F2937; }

.filter-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 8rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6B7280;
  border-radius: 8rpx;
}

.filter-tab.active {
  background: #1E40AF;
  color: #FFFFFF;
  font-weight: 600;
}

/* 错题列表 */
.question-list { margin-bottom: 32rpx; }

.question-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.question-title {
  font-size: 30rpx;
  color: #111827;
  line-height: 1.6;
  display: block;
}

.question-tags {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wrong-count-tag {
  background: #FEE2E2;
  color: #DC2626;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-text { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.status-text.solved { background: #D1FAE5; color: #059669; }
.status-text.unsolved { background: #FEF3C7; color: #D97706; }

.question-date { font-size: 22rpx; color: #9CA3AF; }

/* 答案区 */
.answers {
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.answer-line { display: flex; margin-bottom: 8rpx; }
.answer-line:last-child { margin-bottom: 0; }

.answer-label { font-size: 26rpx; color: #6B7280; flex-shrink: 0; }
.answer-value { font-size: 26rpx; color: #4B5563; line-height: 1.5; }
.answer-value.error { color: #DC2626; }
.answer-value.correct { color: #059669; }

/* 操作按钮 */
.item-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.item-btn {
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}

.item-btn.primary { background: #EFF6FF; color: #1E40AF; }
.item-btn.danger { background: #FEF2F2; color: #DC2626; }
.item-btn::after { border: none; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 34rpx; color: #374151; font-weight: 600; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #9CA3AF; text-align: center; }

.loading {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}
