<!--pages/login/login.wxml-->
<view class="container">
  <!-- 顶部Logo和标题 -->
  <view class="header">
    <view class="logo">🎓</view>
    <text class="app-name">AI中级会计助手</text>
    <text class="app-desc">智能学习，轻松过考</text>
  </view>

  <!-- 微信登录按钮 -->
  <view class="login-section">
    <button class="wechat-login-btn {{loading ? 'loading' : ''}}" 
            bindtap="wechatLogin"
            disabled="{{loading}}">
      <view class="btn-content">
        <text class="btn-text">{{loading ? '登录中...' : '微信快速登录'}}</text>
      </view>
    </button>
    
    <!-- 普通登录按钮 -->
    <button class="normal-login-btn" bindtap="goToNormalLogin">
      <view class="btn-content">
        <text class="btn-text">普通登录</text>
      </view>
    </button>
  </view>


  <!-- 用户协议 -->
  <view class="agreement">
    <text class="agreement-text">
      登录即表示同意
      <text class="agreement-link" bindtap="viewUserAgreement">《用户协议》</text>
      和
      <text class="agreement-link" bindtap="viewPrivacyPolicy">《隐私政策》</text>
    </text>
  </view>

  <!-- 加载遮罩 -->
  <view wx:if="{{loading}}" class="loading-mask">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">登录中...</text>
    </view>
  </view>
</view>
