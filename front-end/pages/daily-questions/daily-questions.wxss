/* pages/daily-questions/daily-questions.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 头部信息 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  color: white;
}

.title-section {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  opacity: 0.8;
}

.timer-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timer {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.timer-label {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 进度区域 */
.progress-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.progress-count {
  font-size: 26rpx;
  color: #1E40AF;
  font-weight: bold;
}

.progress-bar {
  height: 8rpx;
  background-color: #e5e7eb;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1E40AF 0%, #3B82F6 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.score-info {
  text-align: center;
}

.score {
  font-size: 26rpx;
  color: #666;
}

/* 加载状态 */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e7eb;
  border-top: 4rpx solid #1E40AF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 题目区域 */
.question-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.question-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.question-number {
  background: #e0e7ff;
  color: #1E40AF;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.question-difficulty {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
}

.difficulty-easy {
  background-color: #10b981;
}

.difficulty-medium {
  background-color: #f59e0b;
}

.difficulty-hard {
  background-color: #ef4444;
}

.question-chapter {
  font-size: 24rpx;
  color: #666;
}

.question-content {
  margin-bottom: 40rpx;
}

.question-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}

/* 选择题选项 */
.options-list {
  margin-bottom: 40rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  position: relative;
}

.option-item.selected {
  border-color: #1E40AF;
  background-color: #f0f4ff;
}

.option-item.correct {
  border-color: #10b981;
  background-color: #f0fdf4;
}

.option-item.wrong {
  border-color: #ef4444;
  background-color: #fef2f2;
}

.option-key {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
  color: #666;
}

.option-item.selected .option-key {
  background-color: #1E40AF;
  color: white;
}

.option-item.correct .option-key {
  background-color: #10b981;
  color: white;
}

.option-item.wrong .option-key {
  background-color: #ef4444;
  color: white;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
}

.correct-icon, .wrong-icon {
  position: absolute;
  right: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.correct-icon {
  color: #10b981;
}

.wrong-icon {
  color: #ef4444;
}

/* 答案解析 */
.explanation-section {
  background-color: #f8fafc;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.explanation-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.explanation-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.result-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
}

.result-badge.correct {
  background-color: #10b981;
}

.result-badge.wrong {
  background-color: #ef4444;
}

.explanation-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #555;
}

/* 操作按钮 */
.action-buttons {
  margin-bottom: 30rpx;
}

.submit-section {
  display: flex;
  gap: 20rpx;
}

.submit-section .btn-secondary {
  flex: 1;
}

.submit-section .btn-primary {
  flex: 2;
}

.result-buttons {
  display: flex;
  gap: 20rpx;
}

.result-buttons .btn-primary,
.result-buttons .btn-secondary {
  flex: 1;
}

.btn-primary {
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.btn-primary.disabled {
  background: #d1d5db;
  color: #9ca3af;
}

.btn-secondary {
  background: white;
  color: #1E40AF;
  border: 2rpx solid #1E40AF;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 30rpx;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary:active {
  background-color: #f8fafc;
}

/* 控制按钮 */
.control-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.control-btn {
  flex: 1;
  background: white;
  color: #666;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
}

.control-btn:active {
  background-color: #f8fafc;
}