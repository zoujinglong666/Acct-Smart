/* pages/knowledge/knowledge.wxss */

.container {
  padding: 24rpx;
  background: #F3F4F6;
  min-height: 100vh;
}

/* 头部信息卡片 */
.header-card {
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(30, 64, 175, 0.3);
}

.knowledge-header {
  margin-bottom: 32rpx;
}

.knowledge-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.chapter {
  font-size: 26rpx;
  opacity: 0.9;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.difficulty {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.difficulty-easy {
  background: #10B981;
  color: #FFFFFF;
}

.difficulty-medium {
  background: #F59E0B;
  color: #FFFFFF;
}

.difficulty-hard {
  background: #EF4444;
  color: #FFFFFF;
}

.knowledge-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 16rpx;
  display: block;
}

.knowledge-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.study-time,
.current-time {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 进度条 */
.progress-section {
  margin-bottom: 32rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 28rpx;
  font-weight: 600;
}

.progress-percent {
  font-size: 32rpx;
  font-weight: 700;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #FFFFFF;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  backdrop-filter: blur(10rpx);
}

.action-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

.bookmark-btn.bookmarked {
  background: rgba(251, 191, 36, 0.3);
  border-color: rgba(251, 191, 36, 0.5);
}

/* 章节导航 */
.section-nav {
  margin-bottom: 24rpx;
}

.nav-scroll {
  white-space: nowrap;
}

.nav-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #6B7280;
  border: 2rpx solid #E5E7EB;
  transition: all 0.3s ease;
}

.nav-item.active {
  background: #1E40AF;
  color: #FFFFFF;
  border-color: #1E40AF;
}

.nav-item:active {
  transform: scale(0.95);
}

/* 内容卡片 */
.content-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.content-section {
  line-height: 1.8;
}

.content-text {
  font-size: 30rpx;
  color: #1F2937;
  line-height: 1.8;
}

/* 卡片通用样式 */
.keypoints-card,
.examples-card,
.notes-card,
.related-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

/* 要点列表 */
.keypoints-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.keypoint-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  border-left: 6rpx solid #1E40AF;
}

.keypoint-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

/* 实例列表 */
.examples-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.example-item {
  padding: 24rpx;
  background: #F0F9FF;
  border-radius: 12rpx;
  border: 2rpx solid #E0F2FE;
}

.example-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #0369A1;
  margin-bottom: 8rpx;
}

.example-desc {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.5;
}

/* 笔记列表 */
.notes-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.note-item {
  padding: 24rpx;
  background: #FFFBEB;
  border-radius: 12rpx;
  border: 2rpx solid #FEF3C7;
}

.note-content {
  font-size: 28rpx;
  color: #92400E;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.note-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.note-time {
  font-size: 24rpx;
  color: #A3A3A3;
}

.note-delete {
  font-size: 24rpx;
  color: #EF4444;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #FEE2E2;
}

/* 相关知识点 */
.related-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.related-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  border: 2rpx solid #E2E8F0;
  transition: all 0.3s ease;
}

.related-item:active {
  background: #E2E8F0;
  transform: scale(0.98);
}

.related-content {
  flex: 1;
}

.related-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.related-chapter {
  font-size: 24rpx;
  color: #6B7280;
}

/* 底部操作 */
.bottom-actions {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0;
  position: sticky;
  bottom: 0;
  background: #F3F4F6;
  margin: 0 -24rpx -24rpx;
  padding: 24rpx;
}

.bottom-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
}

.primary-btn {
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(30, 64, 175, 0.3);
}

.secondary-btn {
  background: #FFFFFF;
  color: #1E40AF;
  border: 2rpx solid #1E40AF;
}

.bottom-btn:active {
  transform: translateY(2rpx);
}

/* 知识点列表页 */
.list-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 40rpx 20rpx;
}

.list-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.list-desc {
  font-size: 28rpx;
  color: #6B7280;
}

.knowledge-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.knowledge-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.knowledge-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-chapter {
  font-size: 24rpx;
  color: #6B7280;
  background: #F3F4F6;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.completion-status {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  border: 3rpx solid #E5E7EB;
  color: #9CA3AF;
}

.completion-status.completed {
  background: #10B981;
  border-color: #10B981;
  color: #FFFFFF;
}

.item-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 20rpx;
  display: block;
  line-height: 1.4;
}

.item-progress {
  margin-top: 20rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-text {
  font-size: 26rpx;
  color: #1E40AF;
  font-weight: 600;
}

.time-text {
  font-size: 24rpx;
  color: #6B7280;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #E5E7EB;
  border-top: 6rpx solid #1E40AF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #6B7280;
}

/* 笔记对话框 */
.note-dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 40rpx;
}

.note-dialog {
  background: #FFFFFF;
  border-radius: 20rpx;
  width: 100%;
  max-width: 600rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 0;
  border-bottom: 2rpx solid #E5E7EB;
  margin-bottom: 32rpx;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
}

.dialog-close {
  font-size: 48rpx;
  color: #9CA3AF;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-content {
  flex: 1;
  padding: 0 32rpx;
  overflow-y: auto;
}

.note-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1F2937;
  line-height: 1.6;
  box-sizing: border-box;
}

.dialog-footer {
  display: flex;
  gap: 16rpx;
  padding: 32rpx;
  border-top: 2rpx solid #E5E7EB;
}

.dialog-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.cancel-btn {
  background: #F3F4F6;
  color: #6B7280;
}

.confirm-btn {
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  color: #FFFFFF;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .container {
    padding: 16rpx;
  }
  
  .header-card {
    padding: 32rpx;
  }
  
  .knowledge-title {
    font-size: 36rpx;
  }
  
  .action-buttons {
    flex-direction: column;
    gap: 12rpx;
  }
  
  .action-btn {
    height: 64rpx;
    font-size: 24rpx;
  }
  
  .bottom-actions {
    flex-direction: column;
    gap: 12rpx;
  }
}