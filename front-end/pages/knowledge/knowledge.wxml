<!--pages/knowledge/knowledge.wxml-->
<view class="container">
  <!-- 知识点详情页 -->
  <view wx:if="{{knowledgeDetail && !loading}}">
    <!-- 头部信息 -->
    <view class="header-card">
      <view class="knowledge-header">
        <view class="knowledge-meta">
          <text class="chapter">{{knowledgeDetail.chapter}}</text>
          <view class="difficulty difficulty-{{knowledgeDetail.difficulty}}">
            <text wx:if="{{knowledgeDetail.difficulty === 'easy'}}">简单</text>
            <text wx:elif="{{knowledgeDetail.difficulty === 'medium'}}">中等</text>
            <text wx:else="{{knowledgeDetail.difficulty === 'hard'}}">困难</text>
          </view>
        </view>
        <text class="knowledge-title">{{knowledgeDetail.title}}</text>
        <view class="knowledge-info">
          <text class="study-time">📚 预计学习时间：{{knowledgeDetail.estimatedTime}}分钟</text>
          <text class="current-time">⏱️ 当前学习时间：{{Math.floor(studyTime / 60)}}分{{studyTime % 60}}秒</text>
        </view>
      </view>

      <!-- 进度条 -->
      <view class="progress-section">
        <view class="progress-header">
          <text class="progress-label">学习进度</text>
          <text class="progress-percent">{{userProgress}}%</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{userProgress}}%"></view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="action-buttons">
        <button class="action-btn bookmark-btn {{bookmarked ? 'bookmarked' : ''}}" 
                bindtap="toggleBookmark">
          {{bookmarked ? '⭐ 已收藏' : '☆ 收藏'}}
        </button>
        <button class="action-btn note-btn" bindtap="showNoteDialog">
          📝 记笔记
        </button>
        <button class="action-btn speak-btn" bindtap="speakContent">
          🔊 语音播报
        </button>
      </view>
    </view>

    <!-- 章节导航 -->
    <view class="section-nav" wx:if="{{sections.length > 1}}">
      <scroll-view class="nav-scroll" scroll-x="true">
        <view class="nav-item {{currentSection === index ? 'active' : ''}}"
              wx:for="{{sections}}" wx:key="index"
              bindtap="switchSection" data-index="{{index}}">
          {{item.title}}
        </view>
      </scroll-view>
    </view>

    <!-- 内容区域 -->
    <view class="content-card">
      <view class="content-section">
        <rich-text class="content-text" nodes="{{sections[currentSection].content}}"></rich-text>
      </view>
    </view>

    <!-- 要点总结 -->
    <view class="keypoints-card" wx:if="{{knowledgeDetail.keyPoints}}">
      <view class="card-title">🎯 学习要点</view>
      <view class="keypoints-list">
        <view class="keypoint-item" wx:for="{{knowledgeDetail.keyPoints}}" wx:key="index">
          <text class="keypoint-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 实例练习 -->
    <view class="examples-card" wx:if="{{knowledgeDetail.examples}}">
      <view class="card-title">💡 实例练习</view>
      <view class="examples-list">
        <view class="example-item" wx:for="{{knowledgeDetail.examples}}" wx:key="index">
          <text class="example-title">{{item.title}}</text>
          <text class="example-desc">{{item.description}}</text>
        </view>
      </view>
    </view>

    <!-- 我的笔记 -->
    <view class="notes-card" wx:if="{{notes.length > 0}}">
      <view class="card-title">📝 我的笔记</view>
      <view class="notes-list">
        <view class="note-item" wx:for="{{notes}}" wx:key="id">
          <view class="note-content">{{item.content}}</view>
          <view class="note-footer">
            <text class="note-time">{{item.createTime}}</text>
            <text class="note-delete" bindtap="deleteNote" data-id="{{item.id}}">删除</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 相关知识点 -->
    <view class="related-card" wx:if="{{relatedKnowledge.length > 0}}">
      <view class="card-title">🔗 相关知识点</view>
      <view class="related-list">
        <view class="related-item" wx:for="{{relatedKnowledge}}" wx:key="id"
              bindtap="viewRelatedKnowledge" data-id="{{item.id}}">
          <view class="related-content">
            <text class="related-title">{{item.title}}</text>
            <text class="related-chapter">{{item.chapter}}</text>
          </view>
          <view class="difficulty difficulty-{{item.difficulty}}">
            <text wx:if="{{item.difficulty === 'easy'}}">简单</text>
            <text wx:elif="{{item.difficulty === 'medium'}}">中等</text>
            <text wx:else="{{item.difficulty === 'hard'}}">困难</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="bottom-actions">
      <button class="bottom-btn secondary-btn" bindtap="startPractice">
        开始练习
      </button>
      <button class="bottom-btn primary-btn" bindtap="markComplete">
        标记完成
      </button>
    </view>
  </view>

  <!-- 知识点列表页 -->
  <view wx:elif="{{knowledgeList && !loading}}">
    <view class="list-header">
      <text class="list-title">知识点学习</text>
      <text class="list-desc">系统化学习中级会计知识</text>
    </view>

    <view class="knowledge-list">
      <view class="knowledge-item" wx:for="{{knowledgeList}}" wx:key="id"
            bindtap="viewKnowledgeDetail" data-id="{{item.id}}">
        <view class="item-header">
          <view class="item-meta">
            <text class="item-chapter">{{item.chapter}}</text>
            <view class="difficulty difficulty-{{item.difficulty}}">
              <text wx:if="{{item.difficulty === 'easy'}}">简单</text>
              <text wx:elif="{{item.difficulty === 'medium'}}">中等</text>
              <text wx:else="{{item.difficulty === 'hard'}}">困难</text>
            </view>
          </view>
          <view class="completion-status {{item.isCompleted ? 'completed' : ''}}">
            {{item.isCompleted ? '✓' : '○'}}
          </view>
        </view>
        
        <text class="item-title">{{item.title}}</text>
        
        <view class="item-progress">
          <view class="progress-info">
            <text class="progress-text">进度 {{item.progress}}%</text>
            <text class="time-text">{{item.estimatedTime}}分钟</text>
          </view>
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{item.progress}}%"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 笔记对话框 -->
  <view wx:if="{{showNoteDialog}}" class="note-dialog-mask" bindtap="hideNoteDialog">
    <view class="note-dialog" catchtap="">
      <view class="dialog-header">
        <text class="dialog-title">添加笔记</text>
        <text class="dialog-close" bindtap="hideNoteDialog">×</text>
      </view>
      <view class="dialog-content">
        <textarea class="note-textarea" 
                  placeholder="请输入学习笔记..."
                  value="{{noteContent}}"
                  bindinput="onNoteInput"
                  maxlength="500"
                  auto-height></textarea>
      </view>
      <view class="dialog-footer">
        <button class="dialog-btn cancel-btn" bindtap="hideNoteDialog">取消</button>
        <button class="dialog-btn confirm-btn" bindtap="saveNote">保存</button>
      </view>
    </view>
  </view>
</view>