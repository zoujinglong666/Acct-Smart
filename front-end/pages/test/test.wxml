<!--pages/test/test.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="header">
    <text class="title">接口测试</text>
    <text class="subtitle">验证前后端接口对接情况</text>
  </view>

  <!-- 用户状态 -->
  <view class="user-status">
    <view class="status-item">
      <text class="label">登录状态:</text>
      <text class="value {{token === '未登录' ? 'error' : 'success'}}">{{token === '未登录' ? '未登录' : '已登录'}}</text>
    </view>
    <view class="status-item" wx:if="{{userInfo}}">
      <text class="label">用户昵称:</text>
      <text class="value">{{userInfo.nickname || '未设置'}}</text>
    </view>
  </view>

  <!-- 测试按钮组 -->
  <view class="test-buttons">
    <button class="test-btn primary" bindtap="testAuth" disabled="{{loading}}">
      测试认证接口
    </button>
    
    <button class="test-btn" bindtap="testUser" disabled="{{loading}}">
      测试用户接口
    </button>
    
    <button class="test-btn" bindtap="testQuestions" disabled="{{loading}}">
      测试题目接口
    </button>
    
    <button class="test-btn" bindtap="testStudy" disabled="{{loading}}">
      测试学习接口
    </button>
    
    <button class="test-btn" bindtap="testSubmitAnswer" disabled="{{loading}}">
      测试提交答案
    </button>
    
    <button class="test-btn" bindtap="testAddWrongQuestion" disabled="{{loading}}">
      测试添加错题
    </button>
  </view>

  <!-- 批量操作 -->
  <view class="batch-actions">
    <button class="batch-btn primary" bindtap="runAllTests" disabled="{{loading}}">
      {{loading ? '测试中...' : '运行所有测试'}}
    </button>
    
    <button class="batch-btn" bindtap="clearResults" disabled="{{loading}}">
      清空结果
    </button>
    
    <button class="batch-btn danger" bindtap="logout" disabled="{{loading}}" wx:if="{{token !== '未登录'}}">
      退出登录
    </button>
  </view>

  <!-- 测试结果 -->
  <view class="results-section" wx:if="{{testResults.length > 0}}">
    <view class="section-title">
      <text>测试结果 ({{testResults.length}})</text>
    </view>
    
    <view class="results-list">
      <view class="result-item" wx:for="{{testResults}}" wx:key="id" data-index="{{index}}">
        <view class="result-header">
          <text class="timestamp">{{item.timestamp}}</text>
          <view class="result-actions">
            <text class="action-btn" bindtap="viewDetail" data-index="{{index}}" wx:if="{{item.data}}">
              详情
            </text>
            <text class="action-btn" bindtap="copyResult" data-index="{{index}}">
              复制
            </text>
          </view>
        </view>
        
        <view class="result-message">
          <text class="{{item.message.indexOf('✅') === 0 ? 'success' : item.message.indexOf('❌') === 0 ? 'error' : 'info'}}">
            {{item.message}}
          </text>
        </view>
        
        <view class="result-data" wx:if="{{item.data && item.data.length < 200}}">
          <text class="data-preview">{{item.data}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{testResults.length === 0 && !loading}}">
    <text class="empty-text">点击上方按钮开始测试接口</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-content">
      <text class="loading-text">测试进行中...</text>
    </view>
  </view>
</view>