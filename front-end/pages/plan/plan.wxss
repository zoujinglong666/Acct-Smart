/* pages/plan/plan.wxss */

/* 当前计划卡片 */
.current-plan-card {
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(30, 64, 175, 0.3);
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.plan-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.plan-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.plan-status.active {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
}

.plan-progress {
  margin-bottom: 32rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.progress-days {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #FFFFFF;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.plan-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.info-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.plan-actions {
  display: flex;
  gap: 20rpx;
}

.plan-actions .btn-primary,
.plan-actions .btn-secondary {
  flex: 1;
  margin: 0;
}

.plan-actions .btn-secondary {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

/* 无计划状态 */
.no-plan-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
}

.no-plan-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.no-plan-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.no-plan-desc {
  display: block;
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

/* 本周学习安排 */
.weekly-schedule {
  margin-top: 24rpx;
}

.schedule-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F3F4F6;
}

.schedule-item:last-child {
  border-bottom: none;
}

.schedule-item.completed {
  opacity: 0.6;
}

.schedule-day {
  width: 120rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.schedule-content {
  flex: 1;
  margin-left: 24rpx;
}

.schedule-subject {
  display: block;
  font-size: 30rpx;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.schedule-time {
  font-size: 24rpx;
  color: #6B7280;
}

.schedule-status {
  width: 48rpx;
  text-align: center;
}

.status-completed {
  color: #10B981;
  font-size: 32rpx;
  font-weight: 700;
}

.status-pending {
  color: #D1D5DB;
  font-size: 32rpx;
}

/* 学习统计 */
.stats-grid {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0 32rpx 0;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E40AF;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #6B7280;
}

.full-width {
  width: 100%;
}

/* 里程碑 */
.milestones {
  margin-top: 24rpx;
}

.milestone-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F3F4F6;
}

.milestone-item:last-child {
  border-bottom: none;
}

.milestone-item.completed .milestone-icon {
  color: #10B981;
}

.milestone-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #9CA3AF;
  margin-right: 24rpx;
}

.milestone-content {
  flex: 1;
}

.milestone-name {
  display: block;
  font-size: 30rpx;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.milestone-date {
  font-size: 24rpx;
  color: #6B7280;
}

/* 计划列表 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.btn-add {
  background: #1E40AF;
  color: #FFFFFF;
  border: none;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.plan-list {
  margin-top: 24rpx;
}

.plan-item {
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #E5E7EB;
}

.plan-item-content {
  margin-bottom: 20rpx;
}

.plan-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.plan-item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.plan-item-status {
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.plan-item-status.active {
  background: #DBEAFE;
  color: #1E40AF;
}

.plan-item-status.completed {
  background: #D1FAE5;
  color: #10B981;
}

.plan-item-status.draft {
  background: #F3F4F6;
  color: #6B7280;
}

.plan-item-info {
  display: flex;
  justify-content: space-between;
}

.plan-item-date,
.plan-item-progress {
  font-size: 24rpx;
  color: #6B7280;
}

.plan-item-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  background: #F3F4F6;
  color: #6B7280;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn.delete {
  color: #EF4444;
}

/* 创建计划对话框 */
.dialog-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.dialog {
  background: #FFFFFF;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #F3F4F6;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
}

.dialog-close {
  background: none;
  border: none;
  font-size: 48rpx;
  color: #9CA3AF;
  padding: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-content {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-section {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1F2937;
  background: #FFFFFF;
  box-sizing: border-box;
}

.form-input.picker {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.form-input .placeholder {
  color: #9CA3AF;
}

/* 模板列表 */
.template-list {
  margin-top: 16rpx;
}

.template-item {
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  cursor: pointer;
}

.template-item.selected {
  border-color: #1E40AF;
  background: #F0F9FF;
}

.template-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.template-desc {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.template-info {
  display: flex;
  gap: 24rpx;
}

.template-info text {
  font-size: 22rpx;
  color: #1E40AF;
  background: #DBEAFE;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

/* 科目列表 */
.subject-list {
  margin-top: 16rpx;
}

.subject-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  cursor: pointer;
}

.subject-item.selected {
  border-color: #1E40AF;
  background: #F0F9FF;
}

.subject-name {
  font-size: 28rpx;
  color: #1F2937;
}

.subject-check {
  font-size: 24rpx;
  color: #1E40AF;
  font-weight: 700;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
  padding: 32rpx;
  border-top: 2rpx solid #F3F4F6;
}

.dialog-actions .btn-primary,
.dialog-actions .btn-secondary {
  flex: 1;
  margin: 0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 60rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}