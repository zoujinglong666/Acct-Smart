/**app.wxss**/
page {
  background-color: #F3F4F6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #1F2937;
}

/* 通用样式 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 64, 175, 0.08);
  border: 1rpx solid rgba(30, 64, 175, 0.05);
}

.card-gradient {
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  color: #FFFFFF;
}

.btn-primary {
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(30, 64, 175, 0.3);
  transition: all 0.3s ease;
}

.btn-primary:active {
  background: linear-gradient(135deg, #1E3A8A 0%, #1E40AF 100%);
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(30, 64, 175, 0.4);
}

.btn-secondary {
  background: #F3F4F6;
  color: #6B7280;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-secondary:active {
  background: #E5E7EB;
  color: #374151;
}

.btn-success {
  background: linear-gradient(135deg, #10B981 0%, #34D399 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-warning {
  background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
}

/* 文本样式 */
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.subtitle {
  font-size: 32rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.text-body {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.6;
}

.text-primary {
  color: #1E40AF;
}

.text-success {
  color: #10B981;
}

.text-warning {
  color: #F59E0B;
}

.text-error {
  color: #EF4444;
}

.text-muted {
  color: #9CA3AF;
}

/* 布局样式 */
.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  justify-content: center;
  align-items: center;
}

.flex-between {
  justify-content: space-between;
  align-items: center;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* 间距样式 */
.mt-10 { margin-top: 20rpx; }
.mt-15 { margin-top: 30rpx; }
.mt-20 { margin-top: 40rpx; }
.mb-10 { margin-bottom: 20rpx; }
.mb-15 { margin-bottom: 30rpx; }
.mb-20 { margin-bottom: 40rpx; }
.ml-10 { margin-left: 20rpx; }
.mr-10 { margin-right: 20rpx; }

.p-10 { padding: 20rpx; }
.p-15 { padding: 30rpx; }
.p-20 { padding: 40rpx; }

/* 进度条样式 */
.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1976d2, #42a5f5);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background: #e3f2fd;
  color: #1976d2;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.tag-success {
  background: #e8f5e8;
  color: #4caf50;
}

.tag-warning {
  background: #fff3e0;
  color: #ff9800;
}

.tag-error {
  background: #ffebee;
  color: #f44336;
}

/* 列表样式 */
.list-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-content {
  flex: 1;
  margin-left: 20rpx;
}

.list-item-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.list-item-desc {
  font-size: 26rpx;
  color: #999;
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

/* 加载样式 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

/* 统计卡片样式 */
.stats-card {
  background: linear-gradient(135deg, #1976d2, #42a5f5);
  color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.stats-number {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 26rpx;
  opacity: 0.9;
}