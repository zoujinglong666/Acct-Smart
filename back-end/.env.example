# ============ AI中级会计助手 后端环境变量 ============
# 复制本文件为 .env 并填入实际配置：cp .env.example .env

# 服务端口
PORT=8123
HOST=0.0.0.0

# 数据库配置（PostgreSQL）
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=你的数据库密码
DB_DATABASE=acct_smart

# JWT 配置
JWT_SECRET=请替换为随机字符串

# 微信小程序配置（可选，不填则微信登录自动降级为模拟登录，可先用游客模式）
WECHAT_APPID=
WECHAT_SECRET=
